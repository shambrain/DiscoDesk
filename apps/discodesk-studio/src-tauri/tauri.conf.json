{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiscoDesk Studio",
  "version": "0.1.0",
  "identifier": "app.discodesk.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DiscoDesk Studio",
        "width": 880,
        "height": 640,
        "minWidth": 560,
        "minHeight": 440,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
