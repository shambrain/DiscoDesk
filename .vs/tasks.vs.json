{
  "version": "0.2.1",
  "tasks": [
    {
      "taskName": "DiscoDesk: Visual Studio environment doctor",
      "appliesTo": "*",
      "type": "default",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\vs\\Invoke-DiscoDeskVS.ps1",
        "-Action",
        "Doctor"
      ]
    },
    {
      "taskName": "DiscoDesk: Check (format, lint, test, build)",
      "appliesTo": "*",
      "type": "default",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\vs\\Invoke-DiscoDeskVS.ps1",
        "-Action",
        "Check"
      ]
    },
    {
      "taskName": "DiscoDesk: Build Debug",
      "appliesTo": "*",
      "type": "default",
      "contextType": "build",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\vs\\Invoke-DiscoDeskVS.ps1",
        "-Action",
        "BuildDebug"
      ]
    },
    {
      "taskName": "DiscoDesk: Rebuild Debug",
      "appliesTo": "*",
      "type": "default",
      "contextType": "rebuild",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\vs\\Invoke-DiscoDeskVS.ps1",
        "-Action",
        "RebuildDebug"
      ]
    },
    {
      "taskName": "DiscoDesk: Build Optimized with Symbols",
      "appliesTo": "*",
      "type": "default",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\vs\\Invoke-DiscoDeskVS.ps1",
        "-Action",
        "BuildSymbols"
      ]
    },
    {
      "taskName": "DiscoDesk: Test Workspace",
      "appliesTo": "*",
      "type": "default",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\vs\\Invoke-DiscoDeskVS.ps1",
        "-Action",
        "Test"
      ]
    },
    {
      "taskName": "DiscoDesk: Open Developer PowerShell",
      "appliesTo": "*",
      "type": "default",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\vs\\Invoke-DiscoDeskVS.ps1",
        "-Action",
        "DeveloperShell"
      ]
    }
  ]
}
